  "cards": [
    {
      "dot": "violet",
      "title": "One adapter per dialect",
      "items": [
        "withSourceAdapter picks MySQL, Postgres or SQLite from the connection",
        "createKnex sets exact-value parsing per driver",
        "SQL Server is rejected until its adapter exists"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dialect-specific DDL",
      "items": [
        "MySQL: SHOW CREATE TABLE",
        "Postgres: pg_dump --schema-only (must be on PATH)",
        "SQLite: sqlite_master SQL verbatim"
      ]
    },
    {
      "dot": "rose",
      "title": "Never writes to a source",
      "items": [
        "Server sources open read-only sessions",
        "SQLite files open with readonly: true",
        "Passwords decrypted from the OS keychain in main only"
      ]
    }
  ]
